# ==============================================================================
# ShiniTrack Server Environment Configuration Template
# ==============================================================================

# Server network binding
SHINITRACK_LISTEN=0.0.0.0:8787

# Shared secret Bearer token between Android App and Server
SHINITRACK_TOKEN=your-ultra-secure-secret-token-here

# SQLite storage path for poller state, baseline chapters, and event queues
SHINITRACK_DB_PATH=shinitrack-server.db

# Feed polling interval in milliseconds (default: 1000ms with dynamic jitter)
SHINITRACK_POLL_INTERVAL_MS=1000

# Number of latest items to inspect per feed poll request
SHINITRACK_FEED_SIZE=30

# Background reconciliation sweep interval in minutes
SHINITRACK_RECONCILE_MINUTES=10

# Push Notification Provider (ntfy or webpush)
SHINITRACK_PUSH_PROVIDER=ntfy
SHINITRACK_NTFY_URL=https://ntfy.sh
SHINITRACK_NTFY_TOPIC=shinitrack-alerts-private

# Verbose logging (true/false)
SHINITRACK_DEBUG=true
